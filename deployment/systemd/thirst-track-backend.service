[Unit]
Description=Thirst Track Flask Backend API
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/thirst-track2
Environment=PATH=/home/pi/thirst-track2/venv/bin
Environment=FLASK_ENV=production
Environment=PYTHONPATH=/home/pi/thirst-track2
ExecStart=/home/pi/thirst-track2/venv/bin/gunicorn --bind 0.0.0.0:5001 --workers 2 --timeout 120 --access-logfile /home/pi/thirst-track2/logs/access.log --error-logfile /home/pi/thirst-track2/logs/error.log wsgi:app
ExecReload=/bin/kill -s HUP $MAINPID
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=thirst-track-backend

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/home/pi/thirst-track2
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
